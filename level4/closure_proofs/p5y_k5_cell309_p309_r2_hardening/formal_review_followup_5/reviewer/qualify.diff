+        view = memoryview(data)
+        while view:
+            view = view[os.write(fd, view):]
+        os.fsync(fd)
     finally:
         os.close(fd)
+    os.link(tmp, path)                                   # FileExistsError: an existing record is never replaced
+    os.unlink(tmp)
+    _fsync_dir(path.parent)
