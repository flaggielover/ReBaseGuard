[Unit]
Description=P309 explicit once-only administrative request helper candidate
Requires=rebaseguard-p309-admin.socket
After=rebaseguard-p309-admin.socket
[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/local/libexec/rebaseguard-p309/admin-helper-v9
Restart=no
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
StandardInput=null
StandardOutput=null
StandardError=journal
# Never WantedBy the monitor/relay/broker. Administrator starts explicitly only
# after package-specific approval and one-use permit/enrollment provisioning.
