 "definition": {
  "GammaTilde_m": "E_0[A_m T_tau], A_m = (1/w) sum_{r<w} Z_{tau-r}, w = min(m,tau), T_tau = sum_{t<=tau} Z_t, Z_t = X_t - R ~ N(-e,1) under P_e; terminal alarm increment included; random denominator retained (convention A)",
  "decomposition": "P1 T3/T4: A_m T_tau = B_m T_tau + Q_m, Q_m = 1{tau<m}(1/tau - 1/m) T_tau^2 >= 0",
  "detector": "two-sided Gaussian CUSUM, k = 1/2, inclusive threshold h = 5, reset state, no head start",
  "expectation_object": "stopped-path law P_0 restricted to F_tau; score dL_e/de|_0 = -T_tau (L_e = exp(-e T_tau - e^2 tau/2))",
  "m_convention": "terminal reuse window of min(m,tau) raw observations; m=1 is the terminal observation",
  "relation_to_R": "R_m(e) = e + E_e[A_m] (P5-T1, P1 s.1) = K1 raw-variable R (PB3/PB4); P1-T1: F'_{rho,m}(0) = rho(1 - GammaTilde_m), so R_m'(0) = 1 - GammaTilde_m",
  "relation_to_rho_c": "P3-T1: rho_c = 1/|1 - GammaTilde_m|; equals 1/(GammaTilde_m - 1) iff GammaTilde_m > 1",
  "sign_conventions": "no hidden +e, no sign flip (PB3 BOUND); GammaTilde > 1 <=> R'(0) < 0 <=> s(0+) = GammaTilde - 1 > 0",
