+class TestNumericReaders(unittest.TestCase):
+    def test_suspend_and_cgroup_readers_require_bounded_ascii_text(self):
+        for text, expected in (("0", 0), ("003\n", 3), (" 7 ", 7)):
+            self.assertEqual(L.suspend_success_count(text), expected)
+            with mock.patch.object(L, "_read", return_value=text):
+                self.assertEqual(L.suspend_success_count(), expected)
+                self.assertEqual(L._cg_val("/synthetic/limit"), expected)
+        for text in ("²", "１２", "١٢", b"7", 7, True, [], {}, "9" * 5000, "-1", "1.0", ""):
+            with self.subTest(type=type(text).__name__, length=len(text) if isinstance(text, (str, bytes)) else None):
+                self.assertIsNone(L.suspend_success_count(text))
+                with mock.patch.object(L, "_read", return_value=text):
+                    self.assertIsNone(L.suspend_success_count())
+                    self.assertIsNone(L._cg_val("/synthetic/limit"))
+        with mock.patch.object(L, "_read", return_value="max\n"):
+            self.assertEqual(L._cg_val("/synthetic/limit"), "max")
+
