# ReBaseGuard — repository hygiene
#
# Rule: exclude only reproducible build output, caches and OS/editor junk.
# Scientific evidence artifacts (certificates, enclosures, diagnostics, logs,
# reports) are tracked even when they are machine-generated.

# --- macOS / editor junk -----------------------------------------------------
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes
*.swp
*~
.idea/
.vscode/

# --- Lean / Lake build output (regenerated by `lake build`) ------------------
.lake/
**/.lake/
*.olean
*.ilean
*.trace
lakefile.olean

# --- Python environments and caches -----------------------------------------
.venv/
**/.venv/
venv/
env/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- generic build output ----------------------------------------------------
build/
dist/

# --- secrets (never commit) --------------------------------------------------
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
.netrc

# --- scratch -----------------------------------------------------------------
*.log
!closure/**/*.log
scratch/
tmp/
*.tmp
*.bak
